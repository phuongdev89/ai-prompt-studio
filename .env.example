# ==============================================================================
# Chọn nguồn AI mặc định: 'openai' (Custom Router/OpenAI) hoặc 'gemini' (Google Gemini trực tiếp)
# ==============================================================================
AI_PROVIDER=openai

# --- LỰA CHỌN 1: Custom OpenAI / 9Router / One API / Local LLM ---
AI_BASE_URL=https://9router.phuonganh.io.vn/v1
AI_API_KEY=your_openai_or_router_key_here
AI_CHAT_MODEL=ag/gemini-3.7-flash-high
AI_IMAGE_MODEL=ag/gemini-3.1-flash-image
AI_TIMEOUT=300
AI_STREAM=True

# --- LỰA CHỌN 2: Google Gemini Official Direct API (Google AI Studio) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# --- Cấu hình Web Server ---
HOST=127.0.0.1
PORT=8000

