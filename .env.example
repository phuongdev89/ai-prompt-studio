# AI Prompt Studio - Cấu hình môi trường (.env)
# Sao chép file này thành .env và điền giá trị thật. File .env KHÔNG được commit.

# --- AI Provider (OpenAI-compatible) ---
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_CHAT_MODEL=gpt-4o-mini
AI_IMAGE_MODEL=cx/agentgw.cloud-image
AI_IMAGE_REFERENCE_SUPPORT=false
AI_TIMEOUT=300
AI_STREAM=true

# --- S3-compatible storage cho ảnh tham chiếu ---
S3_ENABLED=false
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=references

# Đặt true sau khi đã cấu hình xong
SETUP_DONE=false
