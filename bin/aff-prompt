#!/usr/bin/env bash
# ========================================================
#   AI PROMPT STUDIO - GLOBAL SHELL SHIM LAUNCHER
#   Lệnh: aff-prompt
# ========================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

export PYTHONIOENCODING=utf-8
export PYTHONUTF8=1

if [ -f "$PROJECT_DIR/.venv/Scripts/python.exe" ]; then
    "$PROJECT_DIR/.venv/Scripts/python.exe" "$PROJECT_DIR/cli.py" "$@"
    exit $?
elif [ -f "$PROJECT_DIR/.venv/bin/python" ]; then
    "$PROJECT_DIR/.venv/bin/python" "$PROJECT_DIR/cli.py" "$@"
    exit $?
elif [ -f "$PROJECT_DIR/venv/Scripts/python.exe" ]; then
    "$PROJECT_DIR/venv/Scripts/python.exe" "$PROJECT_DIR/cli.py" "$@"
    exit $?
elif [ -f "$PROJECT_DIR/_internal/python.exe" ]; then
    "$PROJECT_DIR/_internal/python.exe" "$PROJECT_DIR/cli.py" "$@"
    exit $?
elif command -v python &>/dev/null; then
    python "$PROJECT_DIR/cli.py" "$@"
    exit $?
elif command -v python3 &>/dev/null; then
    python3 "$PROJECT_DIR/cli.py" "$@"
    exit $?
else
    echo "[!] Không tìm thấy Python. Vui lòng cài đặt Python 3.10+." >&2
    exit 1
fi
